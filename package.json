{
    "name": "@macromarkets/market-sdk",
    "description": "Official TypeScript SDK and CLI for Macro Markets prediction markets, order books, trading, and portfolio automation",
    "version": "1.0.0",
    "homepage": "https://macro.markets/en",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Macro-Markets/clob-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/Macro-Markets/clob-sdk/issues"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "/dist",
        "/docs/CLI_USAGE.md",
        "/docs/GRAPHQL_APOLLO_USAGE.md",
        "/docs/PUBLISHING.md",
        "/docs/rapidapi"
    ],
    "sideEffects": false,
    "keywords": [
        "prediction-markets",
        "macro-markets",
        "order-book",
        "trading-api",
        "market-sdk",
        "graphql",
        "cli"
    ],
    "engines": {
        "node": ">=20.10"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "packageManager": "pnpm@9.15.4",
    "bin": {
        "market-sdk": "./dist/cli/index.js"
    },
    "scripts": {
        "build": "make build",
        "lint": "make lint",
        "deploy": "pnpm build && npm publish --access public --provenance",
        "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
        "test": "make test",
        "cli": "node --import tsx/esm src/cli/index.ts",
        "market-sdk": "node --import tsx/esm src/cli/index.ts"
    },
    "dependencies": {
        "@apollo/client": "^3.13.8",
        "commander": "^14.0.3",
        "dotenv": "^16.6.1",
        "graphql": "^16.11.0",
        "ink": "^6.8.0",
        "ink-text-input": "^6.0.0",
        "react": "^19.2.4",
        "tslib": "^2.4.0"
    },
    "devDependencies": {
        "@babel/core": "7.23.2",
        "@babel/traverse": ">=7.23.2",
        "@types/chai": "^4.3.3",
        "@types/mocha": "^9.1.1",
        "@types/node": "^22.19.1",
        "@types/react": "^19.2.14",
        "@types/ws": "^8.5.3",
        "@typescript-eslint/eslint-plugin": "^5.37.0",
        "@typescript-eslint/parser": "^5.37.0",
        "chai": "^4.3.6",
        "dotenv": "^16.6.1",
        "eslint": "^8.23.1",
        "eslint-config-prettier": "^8.5.0",
        "eslint-config-standard-with-typescript": "^23.0.0",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-n": "^15.2.5",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^6.0.1",
        "eslint-plugin-unused-imports": "^2.0.0",
        "jsdom": "^20.0.0",
        "jsdom-global": "^3.0.2",
        "mocha": "^10.0.0",
        "nyc": "^15.1.0",
        "path": "^0.12.7",
        "prettier": "^2.7.1",
        "ts-mocha": "^10.0.0",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "ws": "^8.11.0"
    },
    "resolutions": {
        "@babel/traverse": ">=7.23.2"
    }
}
